{
  "name": "square-one",
  "version": "0.11.0",
  "description": "The square-dance engine: formations, call semantics, and choreography paths as pure data.",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "prepare": "pnpm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "fast-check": "4.9.0",
    "license-checker-rseidelsohn": "5.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@12.16.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/randallard/square-one.git"
  }
}
