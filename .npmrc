# Supply-chain posture for this repo. Policy lives in
# .claude/skills/project-conventions/SKILL.md; this file is the enforcement.

# Age-gate new releases at the package-manager level, so it applies to a manual
# `pnpm add` and not just to the update bot's PRs. 7 days: long enough that a
# compromised publish is usually caught and yanked before it can be resolved here.
minimum-release-age=10080

# Install scripts stay blocked. pnpm 10 already defaults to this; stating it means
# a future default change can't silently unblock them. Exceptions are listed one at
# a time in package.json `pnpm.onlyBuiltDependencies`, never blanket-allowed.
ignore-scripts=true

# CI installs frozen; make local behave the same so the lockfile can't drift
# silently between a local install and the gate that verifies it.
resolution-mode=highest
