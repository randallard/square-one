# Secrets and local configuration. Real values live in the environment or the platform's
# secret store, never in the repo. Commit .env.example (placeholders only) instead.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
credentials.json
secrets.toml
secrets.yaml
secrets.yml
*.secret

# Local reference material — never committed (copyrighted; see docs/spec/reference-sources.md)
reference/

# Build output and dependencies. The lockfile IS committed — CI installs frozen.
dist/
node_modules/
coverage/

# Python bytecode (docs-hygiene.py run locally)
__pycache__/
*.pyc
